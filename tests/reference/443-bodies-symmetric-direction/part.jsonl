# 443-bodies-symmetric-direction: added by the parity loop from a Fusion probe
# bodies-symmetric-direction: Block 8x6x4 at x 0..8, y 0..6; body rect-patterned symmetric along X, 3 @12 mm, x 2 along +Y @10 mm (one-sided).
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [8, 0]]}
{"cmd": "sketch.line", "points": [[8, 0], [8, 6]]}
{"cmd": "sketch.line", "points": [[8, 6], [0, 6]]}
{"cmd": "sketch.line", "points": [[0, 6], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 4, "operation": "new_body"}
{"cmd": "pattern.rectangular", "direction": [1, 0, 0], "count": 3, "spacing": 12, "symmetric": true, "direction2": [0, 1, 0], "count2": 2, "spacing2": 10, "join": false}
