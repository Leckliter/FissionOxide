# 486-two-distance-cylinder-top: added by the parity loop from a Fusion probe
# two-distance-cylinder-top: r15 h20 cylinder, two-distance chamfer (2 mm, 6 mm, not flipped) on the top circular edge.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [0, 0], "radius": 15}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "chamfer", "edges": [{"point": [0.0, 15.0, 20.0]}], "distance": 2, "distance2": 6}
