# 427-counterbore-blind-tip90: added by the parity loop from a Fusion probe
# counterbore-blind-tip90: 40x30x20 plate; on the top face at (20,15) a counterbore hole d8 with a d14 x 4 counterbore, blind depth 12 from the top face, 90 deg drill tip.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [20, 15, 20], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.point", "at": [0, 0]}
{"cmd": "sketch.finish"}
{"cmd": "hole", "sketch": 3, "diameter": 8, "kind": "counterbore", "head_diameter": 14, "head_depth": 4, "depth": 12, "tip_angle": "90 deg"}
