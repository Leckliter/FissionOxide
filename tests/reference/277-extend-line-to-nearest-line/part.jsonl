# 277-extend-line-to-nearest-line: added by the parity loop from a Fusion probe
# extend-line-to-nearest-line: Open 40x30 frame: bottom (0,0)-(40,0), right x=40 from y 0 to 35, left x=0, top line (0,30)-(25,30) stopping short, and a farther vertical line x=55 (y -5..35); Extend the top line from its right end, which stops at the nearest line x=40; extrude the closed 40x30 rectangle 10 mm.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 35]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.line", "points": [[0, 30], [25, 30]]}
{"cmd": "sketch.line", "points": [[55, -5], [55, 35]]}
{"cmd": "sketch.extend", "at": [24, 30]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "profiles": [[20, 15]], "distance": 10, "operation": "new_body"}
