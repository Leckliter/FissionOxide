# 378-body-edge-offset-plane: added by the parity loop from a Fusion probe
# 20x10x5 box; construction point where the bottom front edge (y=0,z=0) meets a plane offset 6 from YZ (x=6); plane through it and the vertical edge at (0,10); body mirrored about the plane and joined.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [20, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [20, 10]]}
{"cmd": "sketch.line", "points": [[20, 10], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "plane.offset", "plane": "yz", "offset": 6}
{"cmd": "point", "method": "edge_plane", "edge": {"point": [10, 0, 0]}, "plane": {"feature": 3}}
{"cmd": "plane", "method": "three_points", "a": {"point": 4}, "b": {"at": [0, 10, 0]}, "c": {"at": [0, 10, 5]}}
{"cmd": "mirror", "plane": {"feature": 5}, "bodies": [2000], "join": true}
