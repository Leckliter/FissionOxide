# 360-parallel-body-edges: added by the parity loop from a Fusion probe
# parallel-body-edges: 40x30x20 box; plane through the top-front edge (y=0,z=20) and the bottom-back edge (y=30,z=0), both along X; box split by it into two wedges.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "plane", "method": "two_edges", "a": {"point": [20, 0, 20]}, "b": {"point": [20, 30, 0]}}
{"cmd": "split", "plane": {"feature": 3}, "bodies": [2000]}
