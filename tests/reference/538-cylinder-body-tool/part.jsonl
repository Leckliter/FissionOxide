# 538-cylinder-body-tool: added by the parity loop from a Fusion probe
# cylinder-body-tool: 40x30x20 box and a separate R10 cylinder centred (40,30), z -30..30, overlapping the box's corner; the box is split by the cylinder body: a quarter-cylinder piece and the rest, cylinder kept (3 bodies).
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.circle", "center": [40, 30], "radius": 10}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "extent": "symmetric", "distance": 30, "operation": "new_body"}
{"cmd": "split_by_body", "tool": 4000, "bodies": [2000]}
