# 537-planar-face-tool-not-extended: added by the parity loop from a Fusion probe
# planar-face-tool-not-extended: 40x30x20 box and a 10x50x30 block at x 15..25, y -10..40, z -5..25 passing through it; the box is split by the block's x=15 face with the tool not extended (the face already spans the box): pieces x 0..15 and 15..40, block kept (3 bodies).
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, -5], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[15, -10], [25, -10]]}
{"cmd": "sketch.line", "points": [[25, -10], [25, 40]]}
{"cmd": "sketch.line", "points": [[25, 40], [15, 40]]}
{"cmd": "sketch.line", "points": [[15, 40], [15, -10]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 30, "operation": "new_body"}
{"cmd": "split", "plane": {"point": [15.0, 35.0, 22.0]}, "bodies": [2000]}
