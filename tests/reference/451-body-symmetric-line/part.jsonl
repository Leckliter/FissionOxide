# 451-body-symmetric-line: added by the parity loop from a Fusion probe
# body-symmetric-line: Cube 6x6x6 at x 47..53, y 10..16; body patterned along the line (0,0)->(100,0), 5 instances 15 mm apart, symmetric (both ways from the path start, so copies at -30..+30 mm along X); separate bodies.
# pattern.path is the command Fox would need (it has none yet): pattern along a sketch path
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[47, 10], [53, 10]]}
{"cmd": "sketch.line", "points": [[53, 10], [53, 16]]}
{"cmd": "sketch.line", "points": [[53, 16], [47, 16]]}
{"cmd": "sketch.line", "points": [[47, 16], [47, 10]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 6, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [100, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "pattern.path", "bodies": [2000], "path": 3, "count": 5, "spacing": 15, "symmetric": true, "join": false}
