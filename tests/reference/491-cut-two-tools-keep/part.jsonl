# 491-cut-two-tools-keep: added by the parity loop from a Fusion probe
# cut-two-tools-keep: Box 40x40x20 cut by two cylinders r=6 h=30 at (12,20) and (28,20), keep tools on (3 bodies).
# hand-written
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 40]]}
{"cmd": "sketch.line", "points": [[40, 40], [0, 40]]}
{"cmd": "sketch.line", "points": [[0, 40], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [12, 20], "radius": 6}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 30, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [28, 20], "radius": 6}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 5, "distance": 30, "operation": "new_body"}
{"cmd": "combine", "target": 2000, "tools": [4000, 6000], "operation": "cut", "keep_tools": true}
