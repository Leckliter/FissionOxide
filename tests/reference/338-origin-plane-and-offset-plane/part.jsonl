# 338-origin-plane-and-offset-plane: added by the parity loop from a Fusion probe
# origin-plane-and-offset-plane: 10x10x6 box; construction plane YZ offset 30; axis through the XZ origin plane and that plane (x=30, y=0, along Z); body patterned 3x about it.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [10, 0]]}
{"cmd": "sketch.line", "points": [[10, 0], [10, 10]]}
{"cmd": "sketch.line", "points": [[10, 10], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 6, "operation": "new_body"}
{"cmd": "plane.offset", "plane": "yz", "offset": 30}
{"cmd": "axis", "method": "two_planes", "a": "xz", "b": {"feature": 3}}
{"cmd": "pattern.circular", "axis": {"axis": 4}, "count": 3, "angle": "360 deg", "join": false}
