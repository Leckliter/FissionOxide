# 307-slider-redrive: added by the parity loop from a Fusion probe
# Drive Joints: grounded A 20x20x10, arm B 30x5x5 on top at x 0..30, y 0..5, z 10..15; as-built slider joint at (20,0,10) created with zero motion. Driven to 30 mm, then -7 mm.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 10.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [30, 5]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 5, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [20, 0, 10]}, "fixed": 1, "fixed_origin": {"at": [20, 0, 10], "z": [1, 0, 0], "x": [0, 1, 0]}, "kind": "slider", "as_built": true}
{"cmd": "joint.drive", "joint": 5, "slide": 30}
{"cmd": "joint.drive", "joint": 5, "slide": -7}
{"cmd": "info"}
