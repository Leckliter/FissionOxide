# 520-remove-edge-fillet: added by the parity loop from a Fusion probe
# remove-edge-fillet: 40x30x20 box with an R5 fillet on the vertical edge at (40,30); Remove Faces on the fillet restores the sharp corner
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "fillet", "edges": [{"point": [40.0, 30.0, 10.0]}], "radius": 5}
{"cmd": "remove_faces", "faces": [{"point": [38.535534, 28.535534, 10.0]}]}
