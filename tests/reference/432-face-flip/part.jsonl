# 432-face-flip: added by the parity loop from a Fusion probe
# Joint origin on a face, flipped. Grounded block A 20x20x10 at the origin; block B 10x6x4 at
# x 40..50, y 0..6. B's joint origin at the centre of its top face (45,3,4), flipped; a rigid joint
# puts it on the centre of A's top face (10,10,10).
# Fusion keeps the two joint origins' Z axes pointing the same way; Fox's joint faces them
# unless flipped, so the joint carries flip: true (as in 297-hinged-plate-angle).
{"cmd": "box", "width": 20, "depth": 20, "height": 10, "at": [10, 10]}
{"cmd": "component.create", "name": "A", "bodies": [1000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "box", "width": 10, "depth": 6, "height": 4, "at": [45, 3]}
{"cmd": "component.create", "name": "B", "bodies": [2000]}
{"cmd": "joint_origin", "face": {"point": [45, 3, 4]}, "flip": true, "name": "BO"}
{"cmd": "joint", "moving_origin": {"origin": "BO"}, "fixed": 1, "fixed_origin": {"face": {"point": [10, 10, 10]}}, "kind": "rigid", "flip": true}
{"cmd": "info"}
