# 530-offset-plane-below: added by the parity loop from a Fusion probe
# offset-plane-below: 40x20x10 block; Replace Face swaps its top face (z=10) for a construction plane offset 6 from XY, so the sides trim and the block shrinks to 6 tall (4800 mm3).
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 20]]}
{"cmd": "sketch.line", "points": [[40, 20], [0, 20]]}
{"cmd": "sketch.line", "points": [[0, 20], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "plane.offset", "plane": "xy", "offset": 6}
{"cmd": "replace_face", "faces": [{"point": [20, 10, 10]}], "plane": {"feature": 3}}
