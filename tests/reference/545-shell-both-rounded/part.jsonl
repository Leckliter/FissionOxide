# 545-shell-both-rounded: added by the parity loop from a Fusion probe
# shell-both-rounded: 40x30x20 box shelled 2 mm inside and 1.5 mm outside with the top face (z=20) removed; rounded offset type (outer convex edges become rounds).
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "shell", "faces": [{"point": [20.0, 15.0, 20.0], "normal": [0.0, 0.0, 1.0]}], "thickness": 2, "direction": "both", "outside_thickness": 1.5, "corners": "round"}
