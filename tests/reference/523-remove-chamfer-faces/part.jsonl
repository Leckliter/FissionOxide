# 523-remove-chamfer-faces: added by the parity loop from a Fusion probe
# remove-chamfer-faces: 40x30x20 box, 2 mm chamfer on the 4 top edges, then the 4 chamfer faces are removed and healed (what Remove Features does to chamfers). Expect the plain box back.
# stand-in for Fusion's Remove Features (no script API): remove_faces on the chamfer faces
# sketch Extrude1_sketch: XY
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "chamfer", "edges": [{"point": [0.0, 15.0, 20.0]}, {"point": [20.0, 0.0, 20.0]}, {"point": [40.0, 15.0, 20.0]}, {"point": [20.0, 30.0, 20.0]}], "distance": 2}
{"cmd": "remove_faces", "faces": [{"point": [1, 15, 19]}, {"point": [20, 1, 19]}, {"point": [39, 15, 19]}, {"point": [20, 29, 19]}]}
