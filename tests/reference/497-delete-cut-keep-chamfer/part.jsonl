# 497-delete-cut-keep-chamfer: added by the parity loop from a Fusion probe
# delete-cut-keep-chamfer: 40x30x20 box, a 10x10 square cut 20 deep from z=0 (a through pocket at x,y 15..25 / 10..20), 2 mm chamfer on the 4 top outer edges, then Delete the cut: a solid chamfered box remains.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[15, 10], [25, 10]]}
{"cmd": "sketch.line", "points": [[25, 10], [25, 20]]}
{"cmd": "sketch.line", "points": [[25, 20], [15, 20]]}
{"cmd": "sketch.line", "points": [[15, 20], [15, 10]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 20, "operation": "cut"}
{"cmd": "chamfer", "edges": [{"point": [0.0, 15.0, 20.0]}, {"point": [20.0, 0.0, 20.0]}, {"point": [40.0, 15.0, 20.0]}, {"point": [20.0, 30.0, 20.0]}], "distance": 2}
# Delete Cut1 (feature 4)
{"cmd": "feature.delete", "feature": 4}
