# 200-uneven-spacing: added by the parity loop from a Fusion probe
# uneven-spacing: Fit point spline through (0,0)-(4,10)-(36,12)-(40,2) (short, long, short chords) closed by lines down to y=-8; extruded 4.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.spline", "points": [[0, 0], [4, 10], [36, 12], [40, 2]]}
{"cmd": "sketch.line", "points": [[40, 2], [40, -8]]}
{"cmd": "sketch.line", "points": [[40, -8], [0, -8]]}
{"cmd": "sketch.line", "points": [[0, -8], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 4, "operation": "new_body"}
