# 335-box-vertical-edge-pattern: added by the parity loop from a Fusion probe
# box-vertical-edge-pattern: Box 20x10x5; axis through its vertical edge at (20,0); body patterned 3x over 360 deg about it.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [20, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [20, 10]]}
{"cmd": "sketch.line", "points": [[20, 10], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "axis", "method": "edge", "edge": {"point": [20, 0, 2.5]}}
{"cmd": "pattern.circular", "axis": {"axis": 3}, "count": 3, "angle": "360 deg", "join": false}
