# 398-plane-cell-cut-pocket: added by the parity loop from a Fusion probe
# plane-cell-cut-pocket: 40x40x10 plate; cylinder r=8 h=20 at (20,20) and plane z=5 as tools; the upper cell cuts the plate, tools removed.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [40, 40]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.circle", "center": [20, 20], "radius": 8}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 20, "operation": "new_body"}
{"cmd": "plane.offset", "plane": "xy", "offset": 5}
{"cmd": "boundary_fill", "tools": [4000], "planes": [{"feature": 5}], "cells": [[20, 20, 12]], "operation": "cut", "remove_tools": true}
