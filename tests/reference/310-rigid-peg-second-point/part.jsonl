# 310-rigid-peg-second-point: added by the parity loop from a Fusion probe
# Duplicate With Joints: grounded base A 60x20x5, peg B 10x10x10 built at the origin, rigid joint (angle 0 deg) from B's bottom centre (5,5,0) to (15,10,5) on A's top; B duplicated with its joint, the copy snapped to (45,10,5).
# Fox has no Duplicate With Joints: the closest is component.copy (made before B's joint, as Fox copies the source's posed bodies) and the same joint made again by hand for the copy.
# flip: Fusion's point joints keep both sketch-normal Z axes pointing the same way (B stands on A); Fox's default opposes them.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [60, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [10, 10]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 10, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "component.copy", "component": 2}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [5, 5, 0]}, "fixed": 1, "fixed_origin": {"at": [15, 10, 5]}, "kind": "rigid", "angle": "0 deg", "flip": true}
{"cmd": "joint", "moving": 3, "moving_origin": {"at": [5, 5, 0]}, "fixed": 1, "fixed_origin": {"at": [45, 10, 5]}, "kind": "rigid", "angle": "0 deg", "flip": true}
{"cmd": "info"}
