# 322-rigid-face-offset-angle: added by the parity loop from a Fusion probe
# Joint (Joint Constraint): grounded A 20x20x10 at the origin; B 10x20x5 built at x 40..50, y 0..20. Rigid joint from the centre of B's bottom face to the centre of A's top face, offset 3 mm, angle 90 deg.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [40, 0], "corner2": [50, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 5, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"face": {"point": [45, 10, 0]}}, "fixed": 1, "fixed_origin": {"face": {"point": [10, 10, 10]}}, "kind": "rigid", "offset": 3, "angle": "90 deg"}
{"cmd": "info"}
