# 520-history-boss-rim-fillet: 60x40x20 block; two round bosses 10 tall on the top (r4 at (10,20), dimensioned, and r5 at (30,20)) from one sketch; the r4 boss's rim filleted r1.
# Its variant moves the r4 boss past the r5 one: the fillet must stay on the r4 boss (the r5 rim is then the edge nearest where the filleted one was).
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [60, 40]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 20.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [10, 20], "radius": 4}
{"cmd": "sketch.circle", "center": [30, 20], "radius": 5}
{"cmd": "sketch.dimension", "type": "horizontal", "points": [0, 1], "value": 10}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 10, "operation": "join"}
{"cmd": "fillet", "edges": [{"point": [10, 24, 30]}], "radius": 1}
