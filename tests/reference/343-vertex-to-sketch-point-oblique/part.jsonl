# 343-vertex-to-sketch-point-oblique: added by the parity loop from a Fusion probe
# vertex-to-sketch-point-oblique: 20x10x5 box; sketch point (-10,10) on XY; axis through vertex (20,0,5) then the sketch point (oblique 3D line); body patterned 2x over 90 deg about it.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [20, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [20, 10]]}
{"cmd": "sketch.line", "points": [[20, 10], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.point", "at": [-10, 10]}
{"cmd": "sketch.finish"}
{"cmd": "axis", "method": "two_points", "a": {"vertex": {"point": [20, 0, 2.5]}, "end": true}, "b": {"at": [-10, 10, 0]}}
{"cmd": "pattern.circular", "axis": {"axis": 4}, "count": 2, "angle": "90 deg", "join": false}
