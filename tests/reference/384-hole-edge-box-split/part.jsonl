# 384-hole-edge-box-split: added by the parity loop from a Fusion probe
# hole-edge-box-split: 40x30x20 box with an R6 through hole at (25,12); point at the centre of the hole's top circular edge, (25,12,20); plane through it and the box's bottom-front vertices (0,0,0), (40,0,0); box split by it.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.circle", "center": [25, 12], "radius": 6}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "profiles": [[5, 5]], "distance": 20, "operation": "new_body"}
{"cmd": "point", "method": "vertex", "point": {"center": {"point": [31, 12, 20]}}}
{"cmd": "plane", "method": "three_points", "a": {"point": 3}, "b": {"at": [0, 0, 0]}, "c": {"at": [40, 0, 0]}}
{"cmd": "split", "plane": {"feature": 4}}
