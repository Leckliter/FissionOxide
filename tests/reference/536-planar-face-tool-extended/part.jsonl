# 536-planar-face-tool-extended: added by the parity loop from a Fusion probe
# planar-face-tool-extended: 40x30x20 box and a separate 10x10x5 block at x 15..25, y 40..50; the box is split by the block's x=15 face with the tool extended: box pieces 15 and 25 wide, block untouched (3 bodies).
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[15, 40], [25, 40]]}
{"cmd": "sketch.line", "points": [[25, 40], [25, 50]]}
{"cmd": "sketch.line", "points": [[25, 50], [15, 50]]}
{"cmd": "sketch.line", "points": [[15, 50], [15, 40]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 5, "operation": "new_body"}
{"cmd": "split", "plane": {"point": [15.0, 45.0, 2.5]}, "bodies": [2000]}
