# 281-scale-all-about-origin: added by the parity loop from a Fusion probe
# scale-all-about-origin: plate 20x10 with a r2 hole at (5,5); every curve scaled by 2 about the
# sketch origin, then extruded 5. Expected 40x20x5 with a r4 hole at (10,10).
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 10]}
{"cmd": "sketch.circle", "center": [5, 5], "radius": 2}
{"cmd": "sketch.transform", "scale": 2, "center": [0, 0]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "profiles": [[20, 2]], "distance": 5, "operation": "new_body"}
