# 328-slider-slide: added by the parity loop from a Fusion probe
# Joint (slider), driven: B bottom face centre to A top face centre, slide 5 mm.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [40, 0], "corner2": [50, 6]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 4, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"face": {"point": [45, 3, 0], "normal": [0, 0, -1]}}, "fixed": 1, "fixed_origin": {"face": {"point": [10, 10, 10], "normal": [0, 0, 1]}}, "kind": "slider", "slide": 5}
