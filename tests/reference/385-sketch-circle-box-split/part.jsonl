# 385-sketch-circle-box-split: added by the parity loop from a Fusion probe
# sketch-circle-box-split: 40x30x20 box; on its top face an (unused) R6 sketch circle at (25,12); point at the circle's centre, (25,12,20); plane through it and the box's bottom-front vertices (0,0,0), (40,0,0); box split by it.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 20], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.circle", "center": [25, 12], "radius": 6}
{"cmd": "sketch.finish"}
{"cmd": "point", "method": "vertex", "point": {"center": {"sketch": 3, "curve": 2}}}
{"cmd": "plane", "method": "three_points", "a": {"point": 4}, "b": {"at": [0, 0, 0]}, "c": {"at": [40, 0, 0]}}
{"cmd": "split", "plane": {"feature": 5}}
