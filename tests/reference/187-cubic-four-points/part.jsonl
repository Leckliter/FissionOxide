# 187-cubic-four-points: added by the parity loop from a Fusion probe
# cubic-four-points: Cubic control point spline: control points (0,0)-(10,25)-(30,-5)-(40,10) (one Bezier span) closed by lines down to y=-10; extruded 6.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.control_spline", "points": [[0, 0], [10, 25], [30, -5], [40, 10]]}
{"cmd": "sketch.line", "points": [[40, 10], [40, -10]]}
{"cmd": "sketch.line", "points": [[40, -10], [0, -10]]}
{"cmd": "sketch.line", "points": [[0, -10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 6, "operation": "new_body"}
