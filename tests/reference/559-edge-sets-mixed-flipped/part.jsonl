# 559-edge-sets-mixed-flipped: added by the parity loop from a Fusion probe
# edge-sets-mixed-flipped: 40x30x20 box, one chamfer feature with two edge sets: equal 2 mm on the y=0 top edge, and two-distance 2/6 flipped on the y=30 top edge.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "chamfer", "edges": [{"point": [20.0, 0.0, 20.0]}], "distance": 2}
{"cmd": "chamfer", "edges": [{"point": [20.0, 30.0, 20.0]}], "distance": 2, "distance2": 6, "flipped": true}
