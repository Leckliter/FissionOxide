# 192-hexagon-left-xy: added by the parity loop from a Fusion probe
# hexagon-left-xy: Edge polygon from (0,0) to (10,0), 6 sides, on the left (default) side: regular hexagon of side 10 spanning x -5..15, y 0..17.32; extruded 10.
# sketch S: XY
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.polygon", "edge": [[0, 0], [10, 0]], "sides": 6}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
