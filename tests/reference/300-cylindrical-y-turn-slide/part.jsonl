# 300-cylindrical-y-turn-slide: added by the parity loop from a Fusion probe
# As-built cylindrical constraint: grounded base A 20x20x10 at the origin, arm B 30x5x5 on top of it
# at x 0..30, y 0..5, z 10..15. As-built cylindrical about Y through A's corner (20,0,10), driven to
# 90 deg and 8 mm.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 10.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [30, 5]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 5, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [20, 0, 10]}, "fixed": 1, "fixed_origin": {"at": [20, 0, 10], "z": [0, 1, 0]}, "kind": "cylindrical", "as_built": true, "rotation": "90 deg", "slide": "8 mm"}
{"cmd": "info"}
