{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[-30, -30], [30, -30]]}
{"cmd": "sketch.line", "points": [[30, -30], [30, 30]]}
{"cmd": "sketch.line", "points": [[30, 30], [-30, 30]]}
{"cmd": "sketch.line", "points": [[-30, 30], [-30, -30]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 8, "operation": "new_body"}
