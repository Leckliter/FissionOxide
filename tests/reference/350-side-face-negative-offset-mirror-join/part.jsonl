# 350-side-face-negative-offset-mirror-join: added by the parity loop from a Fusion probe
# side-face-negative-offset-mirror-join: 20x10x6 box; construction plane offset -5 from its x=20 face (x=15, inside the box); box mirrored across it and joined (x 0..30).
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [20, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [20, 10]]}
{"cmd": "sketch.line", "points": [[20, 10], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 6, "operation": "new_body"}
{"cmd": "plane.offset", "plane": {"point": [20, 5, 3], "normal": [1, 0, 0]}, "offset": -5}
{"cmd": "mirror", "plane": {"feature": 3}, "bodies": [2000], "join": true}
