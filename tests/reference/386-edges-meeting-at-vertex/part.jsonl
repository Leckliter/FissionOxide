# 386-edges-meeting-at-vertex: added by the parity loop from a Fusion probe
# edges-meeting-at-vertex: 20x10x5 box; construction point through the top front edge (y=0,z=5) and the vertical edge at (20,0), which meet at the vertex (20,0,5); plane through it and the vertical edge at (0,10); mirrored and joined.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [20, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [20, 10]]}
{"cmd": "sketch.line", "points": [[20, 10], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "point", "method": "two_edges", "a": {"point": [10, 0, 5]}, "b": {"point": [20, 0, 2.5]}}
{"cmd": "plane", "method": "three_points", "a": {"point": 3}, "b": {"at": [0, 10, 0]}, "c": {"at": [0, 10, 5]}}
{"cmd": "mirror", "plane": {"feature": 4}, "bodies": [2000], "join": true}
