# 72-sm-contour-flange: Open Z-shaped sketch on XZ (40 / 30 / 30) -> contour flange, width 50 (typed).
# generated by tools/reference-import/import.py from recipe.json
# sheet metal rule 'Steel (mm)': thickness 2.5, bend radius = thickness, K 0.44
{"cmd": "param.add", "name": "sm_thickness", "expr": "2.5 mm"}
{"cmd": "param.add", "name": "sm_bend_radius", "expr": "sm_thickness"}
{"cmd": "sheet.rule", "name": "Steel (mm)", "thickness": "sm_thickness", "bend_radius": "sm_bend_radius", "k_factor": 0.44}
# the recipe puts the material right of the sketch path's travel; FissionOxide's default is left: flip
# sketch Contour: XZ
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 1.0, 0.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, -30]]}
{"cmd": "sketch.line", "points": [[40, -30], [70, -30]]}
{"cmd": "sketch.finish"}
{"cmd": "sheet.contour_flange", "sketch": 1, "curves": [2, 5, 8], "distance": 50, "rule": "Steel (mm)", "flip": true}
