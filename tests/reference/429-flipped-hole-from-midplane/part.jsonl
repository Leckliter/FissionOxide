# 429-flipped-hole-from-midplane: added by the parity loop from a Fusion probe
# flipped-hole-from-midplane: 40x30x20 block; construction plane offset 8 above XY; a sketch on it with a point at (20,15); simple d6 blind hole depth 7 with 118 deg tip, direction flipped so it drills up (+Z) from z=8, fully inside the block.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 8.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.point", "at": [20, 15]}
{"cmd": "sketch.finish"}
{"cmd": "hole", "sketch": 3, "diameter": 6, "depth": 7, "tip_angle": "118 deg", "flip": true}
