# 234-cylinder-body-silhouette: added by the parity loop from a Fusion probe
# r5 x 20 cylinder along +X (a circle on YZ at the origin, extruded 20); a sketch on a plane at z=20
# projects the whole body unlinked: Fusion projects its silhouette, the 20x10 rectangle x 0..20,
# y -5..5; that rectangle is extruded 3 mm as a new body.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [1.0, 0.0, 0.0], "x": [0.0, 1.0, 0.0]}}
{"cmd": "sketch.circle", "center": [0, 0], "radius": 5}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 20.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.project", "body": 2000, "associative": false}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "profiles": [[10, 0]], "distance": 3, "operation": "new_body"}
