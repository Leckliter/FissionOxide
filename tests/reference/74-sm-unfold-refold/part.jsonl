# 74-sm-unfold-refold: 80x50 base + 20 mm flanges on both long edges; unfold all bends (stationary = base); 10x22 slot (x 35..45, y -12..10) cut across the y=0 bend while flat; refold.
# generated by tools/reference-import/import.py from recipe.json
# sheet metal rule 'Steel (mm)': thickness 2.5, bend radius = thickness, K 0.44
{"cmd": "param.add", "name": "sm_thickness", "expr": "2.5 mm"}
{"cmd": "param.add", "name": "sm_bend_radius", "expr": "sm_thickness"}
{"cmd": "sheet.rule", "name": "Steel (mm)", "thickness": "sm_thickness", "bend_radius": "sm_bend_radius", "k_factor": 0.44}
# sketch Base: XY
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [80, 0]]}
{"cmd": "sketch.line", "points": [[80, 0], [80, 50]]}
{"cmd": "sketch.line", "points": [[80, 50], [0, 50]]}
{"cmd": "sketch.line", "points": [[0, 50], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "sheet.flange", "sketch": 1, "rule": "Steel (mm)"}
{"cmd": "sheet.edge_flange", "edges": [{"point": [40.0, 50.0, 2.5]}, {"point": [40.0, 0.0, 2.5]}], "height": 20, "angle": "90 deg", "position": "inside"}
{"cmd": "sheet.unfold", "face": {"point": [40.0, 25.0, 0.0], "normal": [0.0, 0.0, -1.0]}}
# sketch SlotSketch: XY
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[35, -12], [45, -12]]}
{"cmd": "sketch.line", "points": [[45, -12], [45, 10]]}
{"cmd": "sketch.line", "points": [[45, 10], [35, 10]]}
{"cmd": "sketch.line", "points": [[35, 10], [35, -12]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 5, "extent": "through_all", "operation": "cut", "targets": [2000]}
{"cmd": "sheet.refold"}
