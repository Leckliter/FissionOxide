# 297-hinged-plate-angle: added by the parity loop from a Fusion probe
# Angle Constraint (assembly): grounded component A (40x20x10 block) and component B (20x20x4 plate)
# hinged on A's top x=40 edge and tilted so B's top face is at 30 deg to A's top face.
# Fox has no assembly (angle) constraint; the closest is a revolute joint on the hinge edge driven
# to the angle Fusion's constraint solves to (150 deg fold back over A).
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [40, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [40, 0], "corner2": [60, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 4, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [40, 0, 0], "z": [0, 1, 0]}, "fixed": 1, "fixed_origin": {"at": [40, 0, 10], "z": [0, 1, 0]}, "kind": "revolute", "rotation": "-150 deg"}
