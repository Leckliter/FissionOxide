# 315-revolute-drives-slider: added by the parity loop from a Fusion probe
# Motion Link: grounded A 20x20x10; arm B 30x5x5 on top (x 0..30, y 0..5, z 10..15) on an as-built revolute about Z through (20,0,10); block C 10x10x10 at x 40..50 on an as-built slider along X. Link B 360 deg <-> C 20 mm; B driven to 90 deg, so C slides 5 mm.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 10.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [30, 5]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 5, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [40, 0], "corner2": [50, 10]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 5, "distance": 10, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.create", "name": "C", "bodies": [6000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [20, 0, 10]}, "fixed": 1, "fixed_origin": {"at": [20, 0, 10], "z": [0, 0, 1], "x": [1, 0, 0]}, "kind": "revolute", "as_built": true}
{"cmd": "joint", "moving": 3, "moving_origin": {"at": [40, 0, 0]}, "fixed": 1, "fixed_origin": {"at": [40, 0, 0], "z": [1, 0, 0], "x": [0, 1, 0]}, "kind": "slider", "as_built": true}
{"cmd": "motion_link", "leader": 7, "follower": 8, "leader_value": "360 deg", "follower_value": "20 mm"}
{"cmd": "joint.drive", "joint": 7, "rotation": "90 deg"}
{"cmd": "info"}
