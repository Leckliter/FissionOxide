# 521-history-sketch-on-short-boss: 80x40x20 block; a round boss r4 at (10,20) 10 tall and a wide boss (30..70 x 5..35) 10 tall on its top; a pin r2, 5 tall, sketched on the round boss's top face.
# Its variant makes the round boss 4 tall: the pin's sketch must stay on it (the wide boss's top is then in the plane the sketch was on, and nearer than the lowered face).
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [80, 40]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 20.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [10, 20], "radius": 4}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 10, "operation": "join"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 20.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [30, 5], "corner2": [70, 35]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 5, "distance": 10, "operation": "join"}
{"cmd": "sketch.create", "plane": {"point": [10.0, 20.0, 30.0], "normal": [0.0, 0.0, 1.0]}}
{"cmd": "sketch.circle", "center": [10, 20], "radius": 2}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 7, "distance": 5, "operation": "join"}
