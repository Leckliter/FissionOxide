# 255-text-two-glyphs-hole: added by the parity loop from a Fusion probe
# Sketch text "IO" in Arial, 10 mm capitals, extruded 2 mm: two glyph profiles, the O with a hole; extruding the text with no profiles picked takes the I stroke and the O ring and leaves the counter out, as Fusion does when it extrudes the text object. `at` is the pen origin, shifted left by the I's side bearing.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.text", "at": [-1.3039, 0], "text": "IO", "height": 10, "font": "arial"}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 2, "operation": "new_body"}
