# 489-chamfered-box-compute-all: added by the parity loop from a Fusion probe
# chamfered-box-compute-all: 40x30x20 box, 2 mm top-edge chamfer, then Compute All.
# sketch Extrude1_sketch: XY
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
