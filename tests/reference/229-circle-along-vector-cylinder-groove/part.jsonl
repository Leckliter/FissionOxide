# 229-circle-along-vector-cylinder-groove: added by the parity loop from a Fusion probe
# r10 h30 cylinder; an r5 circle drawn on the plane x=20 is projected onto the side face along
# the X axis (Project To Surface, along vector): two saddle loops, front and back. A d2 pipe cut
# along them makes two grooves.
{"cmd": "cylinder", "radius": 10, "height": 30}
{"cmd": "sketch.create", "plane": {"origin": [20.0, 0.0, 0.0], "normal": [1.0, 0.0, 0.0], "x": [0.0, 1.0, 0.0]}}
{"cmd": "sketch.circle", "center": [0, 15], "radius": 5}
{"cmd": "sketch.finish"}
{"cmd": "sketch.project_to_surface", "sketch": 2, "faces": [{"point": [-10, 0, 5]}], "type": "along_vector", "direction": "x"}
{"cmd": "pipe", "path": 3, "diameter": 2, "operation": "cut"}
