{"cmd": "sketch.constrain", "type": "fix", "points": [5]}
{"cmd": "sketch.constrain", "type": "fix", "points": [8]}
{"cmd": "sketch.constrain", "type": "vertical", "curves": [13]}
{"cmd": "sketch.constrain", "type": "parallel", "curves": [12, 3]}
