# 406-base-extrude-then-fillet: added by the parity loop from a Fusion probe
# base-extrude-then-fillet: 40x30x20 box built inside a base feature, then a parametric 3 mm fillet on the top edges
{"cmd": "base.start"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 2, "distance": 20, "operation": "new_body"}
{"cmd": "base.finish"}
{"cmd": "fillet", "edges": [{"point": [0.0, 15.0, 20.0]}, {"point": [20.0, 0.0, 20.0]}, {"point": [40.0, 15.0, 20.0]}, {"point": [20.0, 30.0, 20.0]}], "radius": 3}
