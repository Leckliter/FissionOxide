# 508-two-sides-negative: added by the parity loop from a Fusion probe
# two-sides-negative: 40x30x20 box; Offset Face on the +X side (x=40) and +Y side (y=30) faces together by -4 mm shrinks it to 36x26x20.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "press_pull", "faces": [{"point": [40.0, 15.0, 10.0]}, {"point": [20.0, 30.0, 10.0]}], "distance": -4}
