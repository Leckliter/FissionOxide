# 373-body-vertex-mirror: added by the parity loop from a Fusion probe
# 20x10x5 box; construction point at the top front-right body vertex (20,0,5); plane through it and the y-axis edge (0,0,0)-(0,10,0) (a slanted plane); body mirrored about the plane and joined.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [20, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [20, 10]]}
{"cmd": "sketch.line", "points": [[20, 10], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "point", "method": "vertex", "point": {"vertex": {"point": [20, 0, 2.5]}, "end": true}}
{"cmd": "plane", "method": "three_points", "a": {"point": 3}, "b": {"at": [0, 0, 0]}, "c": {"at": [0, 10, 0]}}
{"cmd": "mirror", "plane": {"feature": 4}, "bodies": [2000], "join": true}
