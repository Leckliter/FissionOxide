# 313-concentric-stack-offset: added by the parity loop from a Fusion probe
# Constrain Components: grounded A r10 h10 cylinder at the origin, B r5 h10 cylinder built at (40,0); B's bottom circular edge mated concentric to A's top circular edge, flipped, offset -3 mm, so B stands on A's axis at z 13..23.
# Fox has no assembly constraint (mate set); the closest is a rigid joint between the two circle edges with a 3 mm offset.
{"cmd": "cylinder", "radius": 10, "height": 10, "at": [0, 0]}
{"cmd": "component.create", "name": "A", "bodies": [1000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "cylinder", "radius": 5, "height": 10, "at": [40, 0]}
{"cmd": "component.create", "name": "B", "bodies": [2000]}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [40, 0, 0]}, "fixed": 1, "fixed_origin": {"at": [0, 0, 13]}, "kind": "rigid", "flip": true, "angle": "0 deg"}
