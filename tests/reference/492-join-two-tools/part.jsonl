# 492-join-two-tools: added by the parity loop from a Fusion probe
# join-two-tools: Plate 40x40x10 joined with cylinders r=5 h=25 at (0,0) and (40,40).
# hand-written
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 40]]}
{"cmd": "sketch.line", "points": [[40, 40], [0, 40]]}
{"cmd": "sketch.line", "points": [[0, 40], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [0, 0], "radius": 5}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 25, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [40, 40], "radius": 5}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 5, "distance": 25, "operation": "new_body"}
{"cmd": "combine", "target": 2000, "tools": [4000, 6000], "operation": "join", "keep_tools": false}
