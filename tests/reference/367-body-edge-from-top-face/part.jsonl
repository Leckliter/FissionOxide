# 367-body-edge-from-top-face: added by the parity loop from a Fusion probe
# body-edge-from-top-face: Box 40x30x20; plane at angle -30 deg about the top-front body edge (y=0, z=20, along X) from the top face; box split by it into a wedge and the rest.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "axis", "method": "edge", "edge": {"point": [20, 0, 20]}}
{"cmd": "plane", "method": "angle", "axis": {"axis": 3}, "plane": {"point": [20, 15, 20]}, "angle": "-30 deg"}
{"cmd": "split", "plane": {"feature": 4}, "bodies": [2000]}
