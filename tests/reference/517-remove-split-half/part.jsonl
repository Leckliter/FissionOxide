# 517-remove-split-half: added by the parity loop from a Fusion probe
# remove-split-half: 40x30x20 box split by the plane x=10; Remove the 10 mm half (the body containing (5,15,10)): the 30x30x20 half x=10..40 remains.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "split", "plane": {"origin": [10.0, 0.0, 0.0], "normal": [1.0, 0.0, 0.0]}, "bodies": [2000]}
{"cmd": "body.remove", "bodies": [2000]}
