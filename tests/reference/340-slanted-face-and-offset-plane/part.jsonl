# 340-slanted-face-and-offset-plane: added by the parity loop from a Fusion probe
# slanted-face-and-offset-plane: Right-triangle prism (legs 20 and 10, 8 tall); construction plane XY offset 4; axis through the slanted face and that plane (oblique, mid-height); body patterned 3x about it.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [20, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [0, 10]]}
{"cmd": "sketch.line", "points": [[0, 10], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 8, "operation": "new_body"}
{"cmd": "plane.offset", "plane": "xy", "offset": 4}
{"cmd": "axis", "method": "two_planes", "a": {"point": [10, 5, 4], "normal": [0.4472136, 0.8944272, 0]}, "b": {"feature": 3}}
{"cmd": "pattern.circular", "axis": {"axis": 4}, "count": 3, "angle": "360 deg", "join": false}
