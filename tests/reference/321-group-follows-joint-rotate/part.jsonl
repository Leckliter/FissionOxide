# 321-group-follows-joint-rotate: added by the parity loop from a Fusion probe
# Rigid Group: grounded base A 60x20x5; floating blocks B (x 0..10, y 0..10, z 20..30) and C (x 15..25) rigid-grouped,
# then a 90 deg rigid joint mates C's bottom centre (20,5,20) to (30,10,5) on A's top: B swings round with C.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [60, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 20.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [10, 10]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 20.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [15, 0], "corner2": [25, 10]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 5, "distance": 10, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.create", "name": "C", "bodies": [6000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "rigid_group", "components": [2, 3]}
{"cmd": "joint", "moving": 3, "moving_origin": {"at": [20, 5, 20]}, "fixed": 1, "fixed_origin": {"at": [30, 10, 5]}, "kind": "rigid", "angle": "90 deg"}
{"cmd": "info"}
