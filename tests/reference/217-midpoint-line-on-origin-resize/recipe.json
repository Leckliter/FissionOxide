{
 "id": "midpoint-line-on-origin-resize",
 "name": "Midpoint Line: centred on origin, one end dimensioned",
 "description": "Midpoint Line from the sketch origin to (25,0) (other end mirrored to (-25,0), midpoint held on the origin) closed into a rectangle with H/V sides; the right end is dimensioned 20 from the origin so both ends move: x -20..20, y 0..20; extruded 10.",
 "exercises": [
  "sketch_midpoint_line",
  "extrude",
  "sketch_constraints"
 ],
 "units": {
