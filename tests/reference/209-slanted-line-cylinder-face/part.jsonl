# 209-slanted-line-cylinder-face: added by the parity loop from a Fusion probe
# r10 h30 cylinder on XY; a sketch on XZ holds a slanted line (-10,5)-(10,25). Its Intersection
# Curve with the cylinder's side face is a slanted ellipse; a d2 pipe runs along it as a new body.
{"cmd": "cylinder", "radius": 10, "height": 30}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, -1.0, 0.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[-10, 5], [10, 25]]}
{"cmd": "sketch.finish"}
{"cmd": "sketch.intersection_curve", "sketch": 2, "faces": [{"point": [0, -10, 15]}]}
{"cmd": "pipe", "path": 3, "diameter": 2, "operation": "new_body"}
