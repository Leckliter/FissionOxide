# 317-cylindrical-slide-drives-revolute: added by the parity loop from a Fusion probe
# Motion Link from a two-motion joint: grounded A 20x20x10; block B 10x10x10 at x 40..50, y 0..10, z 0..10 on an as-built cylindrical along X through (40,0,0); arm C 30x5x5 at x 0..30, y 30..35, z 0..5 on an as-built revolute about Z through (0,35,0). Link B's slide 10 mm <-> C 90 deg; B slid 10 mm, so C turns 90 deg.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [40, 0], "corner2": [50, 10]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 30], "corner2": [30, 35]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 5, "distance": 5, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.create", "name": "C", "bodies": [6000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [40, 0, 0]}, "fixed": 1, "fixed_origin": {"at": [40, 0, 0], "z": [1, 0, 0], "x": [0, 1, 0]}, "kind": "cylindrical", "as_built": true}
{"cmd": "joint", "moving": 3, "moving_origin": {"at": [0, 35, 0]}, "fixed": 1, "fixed_origin": {"at": [0, 35, 0], "z": [0, 0, 1], "x": [1, 0, 0]}, "kind": "revolute", "as_built": true}
{"cmd": "motion_link", "leader": 7, "follower": 8, "leader_motion": "slide", "leader_value": "10 mm", "follower_value": "90 deg"}
{"cmd": "joint.drive", "joint": 7, "slide": "10 mm"}
{"cmd": "info"}
