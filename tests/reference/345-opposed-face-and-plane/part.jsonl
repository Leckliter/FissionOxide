# 345-opposed-face-and-plane: added by the parity loop from a Fusion probe
# opposed-face-and-plane: 40x30x20 box spanning x 10..50; midplane between its x=10 face (normal -x) and YZ offset 70 (normal +x), i.e. x=40; box mirrored across it as a second body (x 30..70).
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[10, 0], [50, 0]]}
{"cmd": "sketch.line", "points": [[50, 0], [50, 30]]}
{"cmd": "sketch.line", "points": [[50, 30], [10, 30]]}
{"cmd": "sketch.line", "points": [[10, 30], [10, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "plane.offset", "plane": "yz", "offset": 70}
{"cmd": "plane", "method": "midplane", "a": {"point": [10, 15, 10]}, "b": {"feature": 3}}
{"cmd": "mirror", "plane": {"feature": 4}, "bodies": [2000], "join": false}
