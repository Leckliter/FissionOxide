# 518-remove-two-of-three: added by the parity loop from a Fusion probe
# remove-two-of-three: Three boxes: 40x30x20 at origin, 20x20x10 at x=50..70, 10x10x30 at x=80..90; Remove the first and third bodies (two Remove features): only the 20x20x10 box remains.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
