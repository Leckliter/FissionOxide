# 263-break-line-t-junction: added by the parity loop from a Fusion probe
# break-line-t-junction: 40x20 rectangle with a vertical line x=30 whose ends touch the top and bottom edges; Break the bottom edge at (35,0), splitting it at the touch point; delete the 30..40 piece; extrude the closed 30x20 region 10 mm.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0], [40, 20], [0, 20]], "closed": true}
{"cmd": "sketch.line", "points": [[30, 0], [30, 20]]}
{"cmd": "sketch.break", "at": [35, 0]}
{"cmd": "sketch.delete", "curves": [17]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "profiles": [[10, 10]], "distance": 10, "operation": "new_body"}
