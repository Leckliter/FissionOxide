# 314-vertex-face-angle: added by the parity loop from a Fusion probe
# Constrain Components: grounded A 20x20x10, B 30x5x5 bar built at x 40..70, y 0..5; one set: B's corner (40,0,0) coincident with A's top corner (20,20,10), B bottom on A top, B's -y face at 30 deg to A's -y face. Fusion solves B rotated 210 deg about Z through that corner.
# Fox has no assembly constraint (mate set); the closest is a rigid joint at the corners with the solved 210 deg turn.
{"cmd": "box", "width": 20, "depth": 20, "height": 10, "at": [10, 10]}
{"cmd": "component.create", "name": "A", "bodies": [1000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "box", "width": 30, "depth": 5, "height": 5, "at": [55, 2.5]}
{"cmd": "component.create", "name": "B", "bodies": [2000]}
{"cmd": "joint", "moving": 2, "moving_origin": {"at": [40, 0, 0]}, "fixed": 1, "fixed_origin": {"at": [20, 20, 10]}, "kind": "rigid", "angle": "210 deg"}
