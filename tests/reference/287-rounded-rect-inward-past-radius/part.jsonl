# 287-rounded-rect-inward-past-radius: added by the parity loop from a Fusion probe
# rounded-rect-inward-past-radius: 60x40 rectangle with r4 sketch fillets on all corners; Offset 6 inward (past the fillet radius, topology not matched); the region inside the offset extruded 10.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [60, 0]]}
{"cmd": "sketch.line", "points": [[60, 0], [60, 40]]}
{"cmd": "sketch.line", "points": [[60, 40], [0, 40]]}
{"cmd": "sketch.line", "points": [[0, 40], [0, 0]]}
{"cmd": "sketch.fillet", "curves": [2, 5], "radius": 4}
{"cmd": "sketch.fillet", "curves": [5, 8], "radius": 4}
{"cmd": "sketch.fillet", "curves": [8, 10], "radius": 4}
{"cmd": "sketch.fillet", "curves": [10, 2], "radius": 4}
{"cmd": "sketch.offset", "curves": [2, 15, 5, 22, 8, 29, 10, 36], "distance": -6, "topology_matched": false}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "profiles": [[30, 20]], "distance": 10, "operation": "new_body"}
