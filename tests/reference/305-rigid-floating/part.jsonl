# 305-rigid-floating: added by the parity loop from a Fusion probe
# As-Built Joint: grounded A 20x20x10, block B 10x10x6 floating at x 30..40, y 5..15, z 12..18; rigid as-built joint at (20,0,10) keeps B where it is.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 12.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [30, 5], "corner2": [40, 15]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 6, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "fixed": 1, "as_built": true, "moving_origin": {"at": [20, 0, 10]}, "fixed_origin": {"at": [20, 0, 10]}, "kind": "rigid"}
{"cmd": "info"}
