# 295-divider-trimmed-away: added by the parity loop from a Fusion probe
# divider-trimmed-away: 40x30 rectangle split by a line x=20 whose ends sit on the bottom and top edges; Trim it at (20,15): nothing crosses it between its ends, so the whole line goes; extrude the whole rectangle 10 mm.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.line", "points": [[20, 0], [20, 30]]}
{"cmd": "sketch.trim", "at": [20, 15]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "profiles": [[5, 5]], "distance": 10, "operation": "new_body"}
