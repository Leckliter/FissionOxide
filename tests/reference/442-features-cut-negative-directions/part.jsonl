# 442-features-cut-negative-directions: added by the parity loop from a Fusion probe
# features-cut-negative-directions: Plate 60x40x5 at x 0..60, y 0..40; d6 hole at (50,30) cut through 5; feature pattern 4 along -X @12 mm x 2 along -Y @15 mm.
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.line", "points": [[0, 0], [60, 0]]}
{"cmd": "sketch.line", "points": [[60, 0], [60, 40]]}
{"cmd": "sketch.line", "points": [[60, 40], [0, 40]]}
{"cmd": "sketch.line", "points": [[0, 40], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 5, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "x": [1, 0, 0]}}
{"cmd": "sketch.circle", "center": [50, 30], "radius": 3}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 5, "operation": "new_body"}
{"cmd": "pattern.rectangular", "direction": [-1, 0, 0], "count": 4, "spacing": 12, "direction2": [0, -1, 0], "count2": 2, "spacing2": 15, "bodies": [4000], "join": false}
{"cmd": "combine", "target": 2000, "tools": [4000, 5000, 5001, 5002, 5003, 5004, 5005, 5006], "operation": "cut"}
