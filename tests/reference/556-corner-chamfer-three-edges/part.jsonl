# 556-corner-chamfer-three-edges: added by the parity loop from a Fusion probe
# corner-chamfer-three-edges: 40x30x20 box, equal 4 mm chamfer on the three edges meeting at corner (40,30,20), corner type chamfer.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [40, 0]]}
{"cmd": "sketch.line", "points": [[40, 0], [40, 30]]}
{"cmd": "sketch.line", "points": [[40, 30], [0, 30]]}
{"cmd": "sketch.line", "points": [[0, 30], [0, 0]]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "chamfer", "edges": [{"point": [40.0, 15.0, 20.0]}, {"point": [20.0, 30.0, 20.0]}, {"point": [40.0, 30.0, 10.0]}], "distance": 4}
