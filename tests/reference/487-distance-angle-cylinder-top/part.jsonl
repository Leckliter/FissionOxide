# 487-distance-angle-cylinder-top: added by the parity loop from a Fusion probe
# distance-angle-cylinder-top: r15 h20 cylinder, distance-and-angle chamfer (3 mm, 30 deg, not flipped) on the top circular edge.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [0, 0], "radius": 15}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 20, "operation": "new_body"}
{"cmd": "chamfer", "edges": [{"point": [0.0, 15.0, 20.0]}], "distance": 3, "angle": 30}
