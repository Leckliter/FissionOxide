# 325-rigid-face-center-offset: added by the parity loop from a Fusion probe
# Joint (rigid): grounded A 20x20x10 box at the origin; B 10x6x4 box built at x 40..50, y 0..6; B's bottom face centre jointed to A's top face centre, offset 3 mm. Unflipped, Fusion lines the Z axes up the same way, so B turns over below the origin: B at x 5..15, y 7..13, z 9..13.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [0, 0], "corner2": [20, 20]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 1, "distance": 10, "operation": "new_body"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.rect", "corner1": [40, 0], "corner2": [50, 6]}
{"cmd": "sketch.finish"}
{"cmd": "extrude", "sketch": 3, "distance": 4, "operation": "new_body"}
{"cmd": "component.create", "name": "A", "bodies": [2000]}
{"cmd": "component.create", "name": "B", "bodies": [4000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "joint", "moving": 2, "moving_origin": {"face": {"point": [45, 3, 0], "normal": [0, 0, -1]}}, "fixed": 1, "fixed_origin": {"face": {"point": [10, 10, 10], "normal": [0, 0, 1]}}, "kind": "rigid", "offset": 3}
