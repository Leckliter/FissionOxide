# 458-taper-circle-straight: added by the parity loop from a Fusion probe
# taper-circle-straight: r5 circle at the origin on XY swept 40 up +Z along a straight line drawn on XZ with a 5 deg taper angle (outward): a cone frustum.
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 1.0, 0.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.line", "points": [[0, 0], [0, -40]]}
{"cmd": "sketch.finish"}
{"cmd": "sketch.create", "plane": {"origin": [0.0, 0.0, 0.0], "normal": [0.0, 0.0, 1.0], "x": [1.0, 0.0, 0.0]}}
{"cmd": "sketch.circle", "center": [0, 0], "radius": 5}
{"cmd": "sketch.finish"}
{"cmd": "sweep", "sketch": 2, "path": 1, "taper": "5 deg", "operation": "new_body"}
