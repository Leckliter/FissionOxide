# 433-offset-xy: added by the parity loop from a Fusion probe
# Joint origin on a vertex offset along its own X and Y. Grounded block A 20x20x10 at the origin;
# block B 10x6x4 at x 40..50, y 0..6. B's joint origin on its corner (40,0,0) offset 4 in X and 2 in
# Y; a rigid joint puts it on A's top corner (20,20,10). Fox's joint_origin has only a Z offset, so
# offset_x/offset_y are what a Fox equivalent would take (Fox ignores them today).
# Fusion keeps the two joint origins' Z axes pointing the same way; Fox's joint faces them
# unless flipped, so the joint carries flip: true (as in 297-hinged-plate-angle).
{"cmd": "box", "width": 20, "depth": 20, "height": 10, "at": [10, 10]}
{"cmd": "component.create", "name": "A", "bodies": [1000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "box", "width": 10, "depth": 6, "height": 4, "at": [45, 3]}
{"cmd": "component.create", "name": "B", "bodies": [2000]}
{"cmd": "joint_origin", "component": 2, "at": [40, 0, 0], "offset_x": 4, "offset_y": 2, "name": "BO"}
{"cmd": "joint", "moving_origin": {"origin": "BO"}, "fixed": 1, "fixed_origin": {"at": [20, 20, 10]}, "kind": "rigid", "flip": true}
{"cmd": "info"}
