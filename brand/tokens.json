{
  "$description": "FissionOxide design tokens: the one source for colour, type and shape across the desktop app, the website and anything else that carries the brand. Edit this file, then run `python3 brand/build.py`. A string like \"{color.blue.base}\" refers to another token.",
  "name": "FissionOxide",
  "short_name": "fox",
  "tagline": "Parametric 3D CAD",
  "color": {
    "$description": "Colour families. Each part of the app has one, and the fox wears all of the first six. `base` is the colour of the family's icons and accents; `light`, `dark` and `deep` are the lit and shaded facets of the logo and hover/pressed states.",
    "blue": {
      "role": "Solid modelling, and the app's primary accent (selection, links, primary buttons)",
      "logo": "Forehead, eye mask and chin",
      "light": "#4BA6F2", "base": "#1E88E5", "dark": "#1268BE", "deep": "#0F4F9E"
    },
    "orange": {
      "role": "Surface modelling",
      "logo": "Right cheek and muzzle",
      "light": "#FFA54D", "base": "#F5961E", "dark": "#E37A12", "deep": "#C2600C"
    },
    "amber": {
      "role": "Construction geometry (planes, axes, points)",
      "logo": "Left cheek and muzzle",
      "light": "#FFCD4A", "base": "#F7B92E", "dark": "#E8A21E", "deep": "#CC8812"
    },
    "green": {
      "role": "Inspecting, measuring and selecting",
      "logo": "Left jaw",
      "light": "#8ED04F", "base": "#38AC46", "dark": "#2E9A3E", "deep": "#25863A"
    },
    "red": {
      "role": "Delete and stop actions",
      "logo": "Right ear and right jaw",
      "light": "#F0625A", "base": "#DE3832", "dark": "#BC2A27", "deep": "#93201F"
    },
    "purple": {
      "role": "Assemblies, joints and highlights",
      "logo": "Left ear",
      "light": "#B07FEA", "base": "#9660D6", "dark": "#7846BC", "deep": "#55289A"
    },
    "teal": {
      "role": "Sketching",
      "light": "#33ABB3", "base": "#0096A0", "dark": "#007F88", "deep": "#006168"
    },
    "gold": {
      "role": "Mesh bodies",
      "light": "#E0B95D", "base": "#D6A834", "dark": "#B68F2C", "deep": "#8B6D22"
    },
    "coral": {
      "role": "Secondary warm accent in icons",
      "light": "#F0816D", "base": "#EC6248", "dark": "#C9533D", "deep": "#9A402F"
    }
  },
  "logo_families": ["blue", "orange", "amber", "green", "red", "purple"],
  "neutral": {
    "$description": "Slate greys, darkest first.",
    "night": "#121418",
    "ink": "#161B24",
    "graphite": "#2A3342",
    "text": "#2C3646",
    "slate": "#344052",
    "muted": "#707A88",
    "silver": "#9AA4B2",
    "border": "#CCD2DA",
    "line": "#DCE1E7",
    "mist": "#EEF0F3",
    "cloud": "#F3F5F8",
    "paper": "#FAFBFC",
    "white": "#FFFFFF"
  },
  "status": {
    "error": "#D63027",
    "warning": "#E89B00",
    "success": "{color.green.base}",
    "info": "{color.blue.base}"
  },
  "theme": {
    "$description": "Semantic colours for web pages and new apps, in light and dark mode.",
    "light": {
      "background": "{neutral.white}",
      "surface": "{neutral.cloud}",
      "surface-raised": "{neutral.white}",
      "text": "{neutral.ink}",
      "text-muted": "{neutral.muted}",
      "border": "{neutral.border}",
      "accent": "{color.blue.base}",
      "accent-hover": "{color.blue.dark}",
      "accent-text": "{neutral.white}",
      "wordmark": "{neutral.ink}"
    },
    "dark": {
      "background": "{neutral.night}",
      "surface": "#1B2029",
      "surface-raised": "#232A35",
      "text": "#F3F5F8",
      "text-muted": "{neutral.silver}",
      "border": "{neutral.graphite}",
      "accent": "{color.blue.light}",
      "accent-hover": "#6DB8F5",
      "accent-text": "{neutral.night}",
      "wordmark": "#F3F5F8"
    }
  },
  "app": {
    "$description": "The desktop app's own light theme, by the part of the window it paints.",
    "app_bar": "#DEDEDE",
    "toolbar": "#F3F3F3",
    "context_tab": "#D6E9FA",
    "panel": "{neutral.white}",
    "float_header": "{neutral.mist}",
    "pill": "#E5E8ED",
    "pill_root": "{neutral.slate}",
    "border": "{neutral.border}",
    "separator": "{neutral.line}",
    "accent": "{color.blue.base}",
    "accent_dark": "{color.blue.dark}",
    "hover": "#E8F2FC",
    "selected": "#D0E5FA",
    "error": "{status.error}",
    "warning": "{status.warning}",
    "text": "{neutral.text}",
    "muted": "{neutral.muted}",
    "group_label": "{neutral.slate}",
    "dialog_header": "#F0F2F5",
    "dialog_body": "{neutral.paper}",
    "timeline": "{neutral.mist}",
    "icon_ink": "{neutral.slate}",
    "icon_tile_dark": ["{neutral.graphite}", "{neutral.ink}"],
    "icon_tile_light": ["{neutral.white}", "#E9EDF2"]
  },
  "font": {
    "$description": "Inter (SIL Open Font License, rsms.me/inter, also on Google Fonts). Roboto is the fallback where Inter is unavailable.",
    "display": {
      "family": "Inter Display",
      "stack": "\"Inter Display\", \"Inter\", Roboto, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "use": "Wordmark, headlines",
      "weights": [600, 700]
    },
    "body": {
      "family": "Inter",
      "stack": "\"Inter\", Roboto, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "use": "Body text, UI labels",
      "weights": [400, 500, 600]
    },
    "mono": {
      "family": "JetBrains Mono",
      "stack": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
      "use": "Code, expressions, G-code",
      "weights": [400, 600]
    },
    "wordmark": {
      "file": "InterDisplay-Bold.otf",
      "note": "The wordmark is outlined from Inter Display Bold; never retype it."
    }
  },
  "size": {
    "$description": "Type scale in px (1rem = 16px).",
    "xs": 12, "sm": 14, "md": 16, "lg": 20, "xl": 24, "2xl": 32, "3xl": 44, "4xl": 60
  },
  "radius": {
    "$description": "Corner radii in px. The app's controls are tight (2-3 px); icon tiles use 22.5% of their size.",
    "sm": 3, "md": 6, "lg": 12, "xl": 20, "pill": 999, "icon_tile": "22.5%"
  },
  "space": {
    "$description": "Spacing scale in px.",
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96
  }
}
