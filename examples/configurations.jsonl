# A mounting plate in three configurations: Large overrides the width and colours the plate,
# Plain suppresses the hole. The thickness column is driven by a rule: wide plates are 8 mm,
# the rest 5 mm. Export one with --configuration NAME.
{"cmd": "new", "name": "Mounting plate"}
{"cmd": "param.add", "name": "width", "expr": "60 mm"}
{"cmd": "param.add", "name": "thickness", "expr": "5 mm"}
{"cmd": "box", "width": "width", "depth": 40, "height": "thickness", "at": [0, 0]}
{"cmd": "cylinder", "radius": 6, "height": 50, "at": [0, 0], "operation": "cut"}
{"cmd": "config.create", "name": "Large"}
{"cmd": "config.set", "configuration": "Large", "parameter": "width", "expr": "120 mm"}
{"cmd": "config.set", "configuration": "Large", "body": 1000, "appearance": "Aluminum - Anodized Blue"}
{"cmd": "config.create", "name": "Plain"}
{"cmd": "config.set", "configuration": "Plain", "feature": 2, "suppressed": true}
{"cmd": "config.rule", "parameter": "thickness", "expr": "if(width > 100 mm, 8 mm, 5 mm)"}
{"cmd": "config.table"}
{"cmd": "config.activate", "name": "Large"}
{"cmd": "info"}
{"cmd": "config.activate"}
