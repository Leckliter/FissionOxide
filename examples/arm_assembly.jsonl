# A base plate and a swing arm joined by a revolute joint; "swing" drives the arm.
# Ends with an interference check, a bill of materials and a drawing of the assembly.
{"cmd": "new", "name": "Swing arm"}
{"cmd": "param.add", "name": "swing", "expr": "30 deg", "kind": "angle"}
{"cmd": "box", "width": 100, "depth": 60, "height": 10, "at": [50, 30]}
{"cmd": "cylinder", "radius": 5, "height": 10, "at": [50, 30], "operation": "cut"}
{"cmd": "box", "width": 80, "depth": 20, "height": 5, "at": [40, 200]}
{"cmd": "cylinder", "radius": 5, "height": 5, "at": [10, 200], "operation": "cut"}
{"cmd": "component.create", "name": "Base", "bodies": [1000]}
{"cmd": "component.ground", "component": 1}
{"cmd": "component.create", "name": "Arm", "bodies": [3000]}
{"cmd": "component.material", "component": 2, "material": "Aluminum"}
{"cmd": "joint", "moving": 2, "moving_origin": {"edge": {"point": [15, 200, 0]}}, "fixed": 1, "fixed_origin": {"edge": {"point": [55, 30, 10]}}, "kind": "revolute", "rotation": "swing", "limits": {"rotation": ["-90 deg", "90 deg"]}}
{"cmd": "motion.study", "joint": 5, "from": "-90 deg", "to": "90 deg", "steps": 6}
{"cmd": "assembly.interference"}
{"cmd": "assembly.bom"}
{"cmd": "drawing.create", "name": "Assembly", "views": ["front", "top", "iso"]}
{"cmd": "drawing.title", "part_number": "SA-001", "author": "CLFusion"}
